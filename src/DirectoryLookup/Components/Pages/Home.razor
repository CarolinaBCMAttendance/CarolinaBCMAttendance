@page "/"
@inject IDirectorySearchService DirectorySearch
@inject IOptions<DirectoryOptions> DirectorySettings
@implements IDisposable

<PageTitle>Directory Lookup</PageTitle>

<h1>Directory Lookup</h1>
<p class="lookup-lead">
    Select a required domain, then type at least @DirectorySearchQuery.MinimumLetterCount letters.
    A background search connects to the domain and returns user login, name attributes, and role membership.
</p>

@if (DirectorySettings.Value.UseMock)
{
    <div class="alert alert-info" role="status">
        Development sample directory is enabled. Set <code>Directory:UseMock</code> to
        <code>false</code> on Windows to query Active Directory over LDAP.
    </div>
}

<EditForm EditContext="_editContext" class="lookup-form">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="domain" class="form-label">Domain <span class="text-danger">*</span></label>
        <InputSelect id="domain"
                     class="form-select"
                     aria-required="true"
                     @bind-Value="_form.Domain"
                     @bind-Value:after="OnCriteriaChanged">
            <option value="">Select a domain</option>
            @foreach (var domain in _domains)
            {
                <option value="@domain">@domain</option>
            }
        </InputSelect>
        <ValidationMessage For="() => _form.Domain" />
    </div>

    <div class="mb-3">
        <label for="search" class="form-label">User search</label>
        <input id="search"
               class="form-control"
               placeholder="Type at least 5 letters"
               autocomplete="off"
               value="@_form.SearchText"
               @oninput="OnSearchInput" />
        <div class="form-text">@LetterHint</div>
    </div>
</EditForm>

<div class="lookup-status" role="status" aria-live="polite">
    @if (_searching)
    {
        <div class="spinner-border spinner-border-sm me-2" aria-hidden="true"></div>
        <span>@_status</span>
    }
    else if (!string.IsNullOrWhiteSpace(_status))
    {
        <span class="@(_error ? "text-danger" : "text-muted")">@_status</span>
    }
</div>

@if (_outcome?.Succeeded == true)
{
    @if (_outcome.Users.Count == 0)
    {
        <p class="mt-3">No users matched <strong>@_form.SearchText</strong> in <strong>@_outcome.Domain</strong>.</p>
    }
    else
    {
        <div class="user-results mt-4">
            @foreach (var user in _outcome.Users)
            {
                <article class="user-card" data-testid="directory-user">
                    <h2>@(string.IsNullOrWhiteSpace(user.Name.DisplayName) ? user.Login : user.Name.DisplayName)</h2>

                    <section>
                        <h3>User login</h3>
                        <dl>
                            <div><dt>sAMAccountName</dt><dd>@OrDash(user.Login)</dd></div>
                            <div><dt>userPrincipalName</dt><dd>@OrDash(user.UserPrincipalName)</dd></div>
                        </dl>
                    </section>

                    <section>
                        <h3>Name attributes</h3>
                        <dl>
                            <div><dt>displayName</dt><dd>@OrDash(user.Name.DisplayName)</dd></div>
                            <div><dt>givenName</dt><dd>@OrDash(user.Name.GivenName)</dd></div>
                            <div><dt>sn</dt><dd>@OrDash(user.Name.Surname)</dd></div>
                            <div><dt>cn</dt><dd>@OrDash(user.Name.CommonName)</dd></div>
                            <div><dt>mail</dt><dd>@OrDash(user.Name.Mail)</dd></div>
                            <div><dt>title</dt><dd>@OrDash(user.Name.Title)</dd></div>
                            <div><dt>department</dt><dd>@OrDash(user.Name.Department)</dd></div>
                            <div><dt>distinguishedName</dt><dd>@OrDash(user.Name.DistinguishedName)</dd></div>
                        </dl>
                    </section>

                    <section>
                        <h3>Role membership</h3>
                        @if (user.RoleMembership.Count == 0)
                        {
                            <p class="text-muted mb-0">No group memberships returned.</p>
                        }
                        else
                        {
                            <ul class="role-list">
                                @foreach (var role in user.RoleMembership)
                                {
                                    <li>@role</li>
                                }
                            </ul>
                        }
                    </section>
                </article>
            }
        </div>
    }
}

@code {
    private readonly LookupFormModel _form = new();
    private readonly List<string> _domains = [];
    private EditContext _editContext = default!;
    private CancellationTokenSource? _searchCts;
    private DirectorySearchOutcome? _outcome;
    private string _status = string.Empty;
    private bool _searching;
    private bool _error;

    private string LetterHint
    {
        get
        {
            var letters = DirectorySearchQuery.CountLetters(_form.SearchText);
            if (letters >= DirectorySearchQuery.MinimumLetterCount)
            {
                return $"{letters} letters entered.";
            }

            var remaining = DirectorySearchQuery.MinimumLetterCount - letters;
            return $"{letters} letter{(letters == 1 ? "" : "s")} entered. {remaining} more letter{(remaining == 1 ? "" : "s")} needed to search.";
        }
    }

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_form);
        var configured = DirectorySettings.Value.Domains
            .Select(domain => domain.Name)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .ToList();
        _domains.AddRange(configured.Count > 0 ? configured : DirectoryOptions.CreateDefaultDomains().Select(domain => domain.Name));
    }

    private Task OnSearchInput(ChangeEventArgs args)
    {
        _form.SearchText = args.Value?.ToString() ?? string.Empty;
        return OnCriteriaChanged();
    }

    private async Task OnCriteriaChanged()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        _editContext.NotifyValidationStateChanged();
        var domainSelected = !string.IsNullOrWhiteSpace(_form.Domain);
        var hasMinimumLetters = DirectorySearchQuery.HasMinimumLetters(_form.SearchText);

        if (!hasMinimumLetters)
        {
            _outcome = null;
            _error = false;
            _searching = false;
            _status = string.Empty;
            return;
        }

        if (!domainSelected)
        {
            _outcome = null;
            _error = true;
            _searching = false;
            _status = "A domain is required.";
            _editContext.Validate();
            return;
        }

        _error = false;
        _searching = true;
        _status = $"Connecting to {_form.Domain}...";

        try
        {
            await Task.Delay(350, token);
            token.ThrowIfCancellationRequested();

            var outcome = await DirectorySearch.SearchAsync(_form.Domain, _form.SearchText, token);
            token.ThrowIfCancellationRequested();

            _outcome = outcome;
            _error = !outcome.Succeeded;
            _status = outcome.Succeeded
                ? $"Found {outcome.Users.Count} user(s) in {outcome.Domain}."
                : outcome.Error ?? "Search failed.";
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception exception)
        {
            _outcome = null;
            _error = true;
            _status = exception.Message;
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _searching = false;
            }
        }
    }

    private static string OrDash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }
}
